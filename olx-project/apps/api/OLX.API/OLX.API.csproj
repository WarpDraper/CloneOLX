<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- dotnet user-secrets store for local dev (see appsettings.json — secrets were removed
         from source control 2026-08-17, GitGuardian alert). secrets.json lives outside the repo
         at %APPDATA%\Microsoft\UserSecrets\<id>\secrets.json (Windows) or
         ~/.microsoft/usersecrets/<id>/secrets.json (Linux/Mac) and is never committed. -->
    <UserSecretsId>olx-clone-api-7f3e2b9a-4d61-4c8e-9a12-8b5f6e0d1c3a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Helpers\JsonData\Categories.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Common" Version="8.0.11" />
    <!-- SignalRRedis backplane: keeps SignalR groups/Clients.All broadcasts (MessageHub) in sync
         across every API instance behind the load balancer. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="8.0.18" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- CacheRedis: FusionCache's L2 distributed cache (Categories, Adverts). -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="8.0.29" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="8.10.0" />
    <!-- Direct use of StackExchange.Redis types (RedisChannel for the SignalR backplane options,
         IConnectionMultiplexer/RedisKey/RedisValue in RedisRateLimitingMiddleware for
         LimiterRedis). Pinned to match Olx.BLL's reference. -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.37" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
    <PackageReference Include="ZiggyCreatures.FusionCache" Version="2.6.0" />
    <PackageReference Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Olx.BLL\Olx.BLL.csproj" />
    <ProjectReference Include="..\Olx.DAL\Olx.DAL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="backup\" />
    <Folder Include="uploading\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Helpers\JsonData\Categories.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Update="Helpers\JsonData\Filters.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="Helpers\JsonData\Users.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <!-- Real advert photos — DBSeeder copies these directly into wwwroot/images/products/ for
         the 15 seeded adverts, one category per image slug. No JSON advert fixture, no
         third-party image host. Directory is named "products" (not "adverts") so ad-blocker
         extensions that block "/adverts/" URLs (ERR_BLOCKED_BY_CLIENT) don't break the images. -->
    <Content Include="Helpers\JsonData\SeedImages\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="Helpers\EmailTemplates\AccountBlocked.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Helpers\EmailTemplates\AccountRemoved.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Helpers\EmailTemplates\AccountUnblocked.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Helpers\EmailTemplates\AdvertBought.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Helpers\EmailTemplates\AdvertLocked.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Helpers\EmailTemplates\AdvertRemoved.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Helpers\EmailTemplates\EmailConfirmation.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Helpers\EmailTemplates\EmailConfirmed.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Helpers\EmailTemplates\PasswordReset.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties /></VisualStudio></ProjectExtensions>

</Project>
