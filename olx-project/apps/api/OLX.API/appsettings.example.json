{
  "_comment": "Template only. Copy real values into dotnet user-secrets locally (see SECRETS.md) or into deployment environment variables — never fill these placeholders into a tracked file.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "DbSettings": {
    "Server": "<YOUR_DB_HOST>",
    "Port": "5432",
    "Database": "<YOUR_DB_NAME>",
    "UserId": "<YOUR_DB_USER>",
    "Password": "<YOUR_DB_PASSWORD>"
  },
  "ConnectionStrings": {
    "DefaultConnection": "<YOUR_DB_CONNECTION_STRING>",
    "Redis:Cache": "<YOUR_REDIS_CACHE_CONNECTION_STRING>",
    "Redis:SignalR": "<YOUR_REDIS_SIGNALR_CONNECTION_STRING>",
    "Redis:Limiter": "<YOUR_REDIS_LIMITER_CONNECTION_STRING>"
  },
  "JwtOptions": {
    "Key": "<YOUR_JWT_SIGNING_KEY_MIN_32_CHARS>",
    "AccessTokenLifeTimeInMinutes": 10080,
    "RefreshTokenLifeTimeInDays": 30,
    "Issuer": "Olx"
  },
  "ImagesDir": "wwwroot/images",
  "BackupDir": "backup",
  "SeederJsonDir": "Helpers/JsonData",
  "Seeder": {
    "ForceReseedAdverts": false,
    "RunOneTimeSubcategorySeeder": false
  },
  "AdminSeed": {
    "Email": "<YOUR_ADMIN_EMAIL>",
    "Password": "<YOUR_ADMIN_PASSWORD>"
  },
  "RecaptchaSettings": {
    "SecretKey": "<YOUR_RECAPTCHA_SECRET_KEY>",
    "ApiUrl": "https://www.google.com/recaptcha/api/siteverify"
  },
  "AllowedCorsOrigins": "http://localhost:5173",
  "ServerImagePath": "/images",
  "RefreshTokenCookiesName": "__Secure-USER_ID",
  "RefreshTokenCleanupIntervalHours": 1,
  "AdminMessageCleanupIntervalHours": 1,
  "AdminMessageExpDays": 30,
  "ImageCleanupIntervalHours": 1,
  "LockoutTimeSpanMinutes": 5,
  "MaxFailedAccessAttempts": 5,
  "TokenLifespanMinutes": 120,
  "FrontendEmailConfirmationUrl": "http://localhost/auth/register/emailconfirm",
  "FrontendLoginUrl": "http://localhost/auth",
  "FrontendResetPasswordUrl": "http://localhost/auth/password/reset",
  "GoogleUserInfoUrl": "https://www.googleapis.com/oauth2/v3/userinfo",
  "NewPostApiUrl": "https://api.novaposhta.ua/v2.0/json/",
  "NewPostApiKey": "<YOUR_NOVAPOSHTA_API_KEY>",
  "GeminiApiKey": "<YOUR_GEMINI_API_KEY>",
  "Gemini": {
    "_comment": "Preferred shape for Gemini config (GeminiOptions). ApiKey here overrides the flat GeminiApiKey above if both are set; Model/ApiUrl are optional and default to gemini-3.5-flash-lite / https://generativelanguage.googleapis.com/v1beta when blank.",
    "ApiKey": "<YOUR_GEMINI_API_KEY>",
    "Model": "gemini-3.5-flash-lite",
    "ApiUrl": "https://generativelanguage.googleapis.com/v1beta"
  },
  "TelegramBotToken": "",
  "TelegramBotUsername": "",
  "QrCodeTargetUrl": "https://example.com",
  "MailSettings": {
    "Server": "smtp.ukr.net",
    "Port": 465,
    "SenderName": "MultiMart",
    "SenderEmail": "<YOUR_SENDER_EMAIL>",
    "Account": "<YOUR_SMTP_ACCOUNT>",
    "Password": "<YOUR_SMTP_APP_PASSWORD>"
  },
  "ImageSizes": []
}
