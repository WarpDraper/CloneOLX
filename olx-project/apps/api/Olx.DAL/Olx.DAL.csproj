<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- OlxDbContext calls the Pgvector.EntityFrameworkCore UseVector() extension directly, so
         this project needs its own explicit reference (also flows transitively from Olx.BLL,
         but pin it here since it's used directly in this project). -->
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Olx.BLL\Olx.BLL.csproj" />
  </ItemGroup>

</Project>
