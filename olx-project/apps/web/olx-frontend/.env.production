# Tracked on purpose — non-secret build-time defaults only (see .gitignore / SECRETS.md).
# Real production values for the keys below (if they differ) go in .env.production.local, which
# is gitignored and applied on top of this file by Vite at build time.

VITE_API_BASE_URL=https://<YOUR_PRODUCTION_API_DOMAIN>

VITE_RECAPTCHA_SITE_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_UNSPLASH_ACCESS_KEY=
VITE_TELEGRAM_BOT_ID=
