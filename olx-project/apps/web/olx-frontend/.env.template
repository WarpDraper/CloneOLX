# Copy this file to .env.development.local (or .env.production.local) and fill in real values.
# Never put real secrets/keys into .env.development or .env.production directly — those two are
# tracked in git for non-secret defaults only (see .gitignore and SECRETS.md for why: a real
# reCAPTCHA site key was committed that way once already).

PORT=5173
VITE_API_BASE_URL=http://localhost:5005

# reCAPTCHA v2/v3 site key (public, but rotate via *.local if regenerated) — Google reCAPTCHA
# admin console.
VITE_RECAPTCHA_SITE_KEY=

# OAuth 2.0 Web Client ID from Google Cloud Console (public identifier, not a secret).
VITE_GOOGLE_CLIENT_ID=

# Unsplash API access key, if the Unsplash fallback is ever re-enabled.
VITE_UNSPLASH_ACCESS_KEY=

# Numeric Telegram bot id from @BotFather (public identifier, not a secret).
VITE_TELEGRAM_BOT_ID=
